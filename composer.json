{
  "autoload": {
    "psr-4": {
      "LoopressLib\\": "lib/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "8.2.29"
    }
  },
  "extra": {
    "installer-paths": {
      "../plugins/{$name}/": ["type:wordpress-plugin"],
      "../themes/{$name}/": ["type:wordpress-theme"]
    }
  },
  "name": "loopress/site-dependencies",
  "version": "0.0.0",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "composer/installers": "^2.0",
    "guzzlehttp/guzzle": "^7.0",
    "phpoffice/phpspreadsheet": "^5.9",
    "dompdf/dompdf": "^3.1",
    "webonyx/graphql-php": "^15.37",
    "league/oauth2-server": "^9.1",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1"
  }
}
