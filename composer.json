{
  "autoload": {
    "psr-4": {
      "LoopressLib\\": "lib/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "8.2.29"
    }
  },
  "extra": {
    "installer-paths": {
      "../plugins/{$name}/": ["type:wordpress-plugin"],
      "../themes/{$name}/": ["type:wordpress-theme"]
    }
  },
  "name": "loopress/site-dependencies",
  "version": "0.0.0",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "composer/installers": "^2.0",
    "guzzlehttp/guzzle": "^7.0"
  }
}
